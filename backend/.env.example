# Copy this file to .env and fill in real values.
# Never commit the actual .env file (already covered by root .gitignore).

PORT=5000

# Path to the SQLite database file (relative to backend/)
DB_PATH=./database/x-reach.db

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=10

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Groq API key, used to generate natural-language patient/doctor explanations
# on top of the existing LIME-based explanation (see
# backend/services/groqExplanationService.js). Get a key at
# https://console.groq.com/keys. Optional: if left blank, predictions still
# work and just won't include the LLM-generated explanation text.
GROQ_API_KEY=
# Optional: override the Groq model used for explanations.
GROQ_MODEL=openai/gpt-oss-120b
