// Copy this file to config.h and fill in real values.
// NEVER commit config.h with real WiFi credentials or a real device key
// (config.h is covered by the root .gitignore's `iot/firmware/config.h` rule).

#ifndef ELARA_CONFIG_H
#define ELARA_CONFIG_H

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// Base URL of the ELARA backend (use HTTPS in any real deployment).
#define API_BASE_URL    "http://192.168.1.100:5000/api"

// Obtained once from POST /api/iot/devices (see ../communication/device-protocol.md).
// Store these in NVS/EEPROM on real hardware instead of a compiled-in string;
// this header is a development-only convenience.
#define DEVICE_IDENTIFIER "esp32-replace-with-real-id"
#define DEVICE_KEY        "replace-with-key-returned-at-registration"

// How often to attempt an ingest POST, in milliseconds.
#define INGEST_INTERVAL_MS 60000

#endif
